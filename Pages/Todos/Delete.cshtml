@page "{id:guid}"
@model TodoApp.Pages.Todos.DeleteModel
@{
    ViewData["Title"] = "Görev Sil";
}

<h1 class="mb-3">Görev Sil</h1>

<div class="alert alert-warning" role="alert">
    <p class="mb-0">Bu görevi silmek istediğinize emin misiniz?</p>
    <p class="mb-0">@Model.Todo?.Title</p>
</div>

<form method="post">
    <input type="hidden" asp-for="Todo.Id" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-danger">Sil</button>
        <a asp-page="./Index" class="btn btn-secondary">İptal</a>
    </div>
</form>
